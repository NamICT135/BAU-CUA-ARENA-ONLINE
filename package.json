{
  "name": "bau-cua-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite",
    "dev:server": "node server.js",
    "server": "node server.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "test": "npm run test:all",
    "test:core": "node --test tests/automatic.test.js tests/database-game-integration.test.js tests/game.test.js tests/history.test.js tests/media.test.js tests/multiplayer.test.js",
    "test:db": "node scripts/run-db-tests.js",
    "test:all": "npm run test:core && npm run test:db",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node scripts/db-migrate.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
